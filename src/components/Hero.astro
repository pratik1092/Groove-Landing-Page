---
import DownloadCTA from "./DownloadCTA.astro";
import { tagline } from "../lib/site";
---

<section id="hero" class="relative min-h-dvh overflow-hidden">
  <div class="absolute inset-0" aria-hidden="true">
    <video
      class="hero-video-ken absolute inset-0 h-full w-full object-cover"
      data-hero-video
      poster="/media/hero-poster.jpg"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
    >
      <source src="/media/hero.mp4" type="video/mp4" />
    </video>
    <img
      class="absolute inset-0 hidden h-full w-full object-cover"
      data-hero-poster
      src="/media/hero-poster.jpg"
      alt=""
      width="2592"
      height="1080"
    />
    <div class="hero-vignette absolute inset-0"></div>
    <div class="hero-type-wash absolute inset-0"></div>
  </div>

  <div
    class="relative z-10 mx-auto flex min-h-dvh max-w-6xl flex-col justify-end px-5 pb-16 pt-36 sm:px-8 sm:pb-20 lg:justify-center lg:pb-24"
  >
    <div class="hero-animate max-w-xl lg:max-w-2xl">
      <div class="flex items-center gap-3">
        <img
          src="/brand/app-icon.png"
          alt=""
          width="56"
          height="56"
          class="size-14 rounded-[14px] shadow-[0_12px_40px_rgb(0_0_0_/_0.5)] ring-1 ring-white/15"
        />
        <p class="font-display text-2xl tracking-tight text-white/90 sm:text-3xl">Groove</p>
      </div>

      <h1
        class="mt-8 text-balance font-display text-[clamp(2.75rem,7vw,5rem)] leading-[0.98] tracking-tight text-white drop-shadow-[0_8px_32px_rgb(0_0_0_/_0.55)]"
      >
        Your desktop, spinning.
      </h1>

      <p
        class="mt-5 max-w-md text-pretty text-lg leading-relaxed text-white/75 sm:text-xl"
      >
        {tagline}
      </p>

      <div class="mt-9 flex flex-wrap items-center gap-3">
        <DownloadCTA size="lg" variant="accent" label="Download for Mac" />
        <a
          href="#live"
          class="cta-magnetic inline-flex h-[52px] items-center justify-center rounded-full border border-white/15 bg-white/8 px-6 text-[15px] font-semibold text-white backdrop-blur-md transition-colors hover:bg-white/14"
        >
          See how it feels
        </a>
      </div>

      <p class="mt-6 text-sm text-white/45">Free · macOS 14+ · Direct download</p>
    </div>

    <a
      href="#live"
      class="mt-14 inline-flex items-center gap-3 self-start text-sm font-medium text-white/50 transition-colors hover:text-white/80 lg:mt-16"
      aria-label="Scroll to next section"
    >
      <span
        class="scroll-cue-dot inline-flex size-8 items-center justify-center rounded-full border border-white/20"
      >
        <svg class="size-3.5" viewBox="0 0 12 12" fill="none" aria-hidden="true">
          <path
            d="M2.5 4.5 6 8l3.5-3.5"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </span>
      Scroll
    </a>
  </div>

</section>
