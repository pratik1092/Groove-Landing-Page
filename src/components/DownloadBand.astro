---
import DownloadCTA from "./DownloadCTA.astro";
import { appRepoUrl, appVersion } from "../lib/site";
---

<section
  id="download"
  class="relative overflow-hidden px-5 py-24 sm:px-8 sm:py-32"
  data-light-band
>
  <div
    class="reveal-scale relative mx-auto max-w-4xl overflow-hidden rounded-[2rem] border border-[var(--color-line-light)] bg-white px-6 py-16 text-center shadow-[0_30px_80px_rgb(20_20_22_/_0.08)] sm:rounded-[2.75rem] sm:px-12 sm:py-20"
  >
    <div
      class="pointer-events-none absolute -left-16 top-0 size-64 rounded-full bg-[var(--color-accent)]/15 blur-3xl"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute -right-12 bottom-0 size-56 rounded-full bg-[var(--color-silver)]/40 blur-3xl"
      aria-hidden="true"
    >
    </div>

    <div class="relative">
      <img
        src="/brand/app-icon.png"
        alt=""
        width="72"
        height="72"
        class="mx-auto size-[72px] rounded-[18px] shadow-[0_12px_32px_rgb(0_0_0_/_0.2)] ring-1 ring-black/5"
      />
      <h2
        class="mt-8 text-balance font-display text-4xl tracking-tight text-[var(--color-fg-light)] sm:text-5xl"
      >
        Drop the needle.
      </h2>
      <p class="mx-auto mt-4 max-w-md text-lg text-[var(--color-muted-light)]">
        Drag Groove into Applications. Play a track. Your desk starts spinning.
      </p>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
        <DownloadCTA size="lg" variant="accent" label="Download Groove 1.0" />
        <a
          href={appRepoUrl + "/releases"}
          class="inline-flex h-[52px] items-center rounded-full border border-black/8 bg-[var(--color-bg-light)] px-6 text-[15px] font-semibold text-[var(--color-fg-light)] transition-all duration-300 hover:-translate-y-0.5 hover:bg-white"
          target="_blank"
          rel="noopener noreferrer"
        >
          View release notes
        </a>
      </div>
      <p class="mt-6 text-sm text-[var(--color-muted-light)]">
        Groove {appVersion} · Gatekeeper may ask you to Open once · Automation for
        Spotify / Music
      </p>
    </div>
  </div>
</section>
