---
interface Props {
  id: string;
  eyebrow: string;
  headline: string;
  support: string;
  mediaSrc: string;
  mediaAlt: string;
  mediaType?: "image" | "video";
  videoSrc?: string;
  /** Extra stills to shuffle with mediaSrc (crossfade gallery). */
  stills?: string[];
  reverse?: boolean;
}

const {
  id,
  eyebrow,
  headline,
  support,
  mediaSrc,
  mediaAlt,
  mediaType = "image",
  videoSrc,
  stills = [],
  reverse = false,
} = Astro.props;

const gallery = [mediaSrc, ...stills.filter((s) => s !== mediaSrc)];
const useGallery = mediaType !== "video" && gallery.length > 1;
---

<section id={id} class="relative px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
  <div
    class:list={[
      "mx-auto grid max-w-[1440px] items-center gap-8 lg:gap-12 xl:gap-14",
      reverse
        ? "lg:grid-cols-[minmax(0,1.4fr)_minmax(280px,0.85fr)]"
        : "lg:grid-cols-[minmax(280px,0.85fr)_minmax(0,1.4fr)]",
    ]}
  >
    <div class:list={["reveal px-1 sm:px-2", reverse && "lg:order-2"]}>
      <p
        class="text-[13px] font-semibold uppercase tracking-[0.18em] text-[var(--color-accent)] sm:text-sm"
      >
        {eyebrow}
      </p>
      <h2
        class="mt-4 text-balance font-display text-[clamp(2.6rem,5.5vw,4.25rem)] leading-[1.02] tracking-tight text-white"
      >
        {headline}
      </h2>
      <p class="mt-5 max-w-lg text-pretty text-lg leading-relaxed text-white/60 sm:text-xl">
        {support}
      </p>
    </div>

    <div
      class:list={[
        "reveal reveal-delay-2 reveal-scale min-w-0",
        reverse && "lg:order-1",
      ]}
    >
      <div class="media-frame">
        <div
          class="media-lift relative overflow-hidden rounded-[1.75rem] border border-white/10 bg-[#0a0a0c] sm:rounded-[2.25rem]"
          data-parallax
          data-parallax-speed="0.06"
        >
          {
            mediaType === "video" && videoSrc ? (
              <video
                class="aspect-[12/5] w-full object-contain object-center"
                data-section-video
                poster={mediaSrc}
                muted
                loop
                playsinline
                preload="none"
              >
                <source src={videoSrc} type="video/mp4" />
              </video>
            ) : useGallery ? (
              <div class="relative aspect-[12/5] w-full" data-still-crossfade>
                {gallery.map((src, i) => (
                  <img
                    src={src}
                    alt={i === 0 ? mediaAlt : ""}
                    width="2400"
                    height="1000"
                    class:list={[
                      "absolute inset-0 h-full w-full object-contain object-center transition-opacity",
                      i === 0 ? "opacity-100" : "opacity-0",
                    ]}
                    data-still
                    loading={i === 0 ? "eager" : "lazy"}
                    decoding="async"
                    aria-hidden={i === 0 ? undefined : "true"}
                  />
                ))}
              </div>
            ) : (
              <img
                src={mediaSrc}
                alt={mediaAlt}
                width="2400"
                height="1000"
                class="aspect-[12/5] w-full object-contain object-center"
                loading="lazy"
                decoding="async"
              />
            )
          }
        </div>
      </div>
    </div>
  </div>
</section>
