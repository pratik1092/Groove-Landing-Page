---
interface Props {
  id: string;
  eyebrow: string;
  headline: string;
  support: string;
  mediaSrc: string;
  mediaAlt: string;
  mediaType?: "image" | "video";
  videoSrc?: string;
  reverse?: boolean;
}

const {
  id,
  eyebrow,
  headline,
  support,
  mediaSrc,
  mediaAlt,
  mediaType = "image",
  videoSrc,
  reverse = false,
} = Astro.props;
---

<section id={id} class="relative overflow-hidden px-5 py-24 sm:px-8 sm:py-32">
  <div
    class:list={[
      "mx-auto grid max-w-6xl items-center gap-10 lg:gap-16",
      reverse ? "lg:grid-cols-[1.05fr_0.95fr]" : "lg:grid-cols-[0.95fr_1.05fr]",
    ]}
  >
    <div class:list={["reveal", reverse && "lg:order-2"]}>
      <p
        class="text-[13px] font-semibold uppercase tracking-[0.18em] text-[var(--color-accent)]"
      >
        {eyebrow}
      </p>
      <h2
        class="mt-4 text-balance font-display text-[clamp(2.1rem,4.5vw,3.5rem)] leading-[1.05] tracking-tight text-white"
      >
        {headline}
      </h2>
      <p class="mt-5 max-w-md text-pretty text-lg leading-relaxed text-white/60">
        {support}
      </p>
    </div>

    <div
      class:list={[
        "reveal reveal-delay-2 reveal-scale",
        reverse && "lg:order-1",
      ]}
    >
      <div
        class="media-lift relative overflow-hidden rounded-[1.5rem] border border-white/10 bg-black/40 shadow-[0_24px_80px_rgb(0_0_0_/_0.45)] sm:rounded-[2rem]"
        data-parallax
        data-parallax-speed="0.06"
      >
        {
          mediaType === "video" && videoSrc ? (
            <video
              class="aspect-[21/9] w-full object-cover"
              data-section-video
              poster={mediaSrc}
              muted
              loop
              playsinline
              preload="none"
            >
              <source src={videoSrc} type="video/mp4" />
            </video>
          ) : (
            <img
              src={mediaSrc}
              alt={mediaAlt}
              width="2400"
              height="1000"
              class="aspect-[21/9] w-full object-cover"
              loading="lazy"
              decoding="async"
            />
          )
        }
        <div
          class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/35 via-transparent to-transparent"
          aria-hidden="true"
        >
        </div>
      </div>
    </div>
  </div>
</section>
